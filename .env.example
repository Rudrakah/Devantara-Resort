# Copy this file to .env and replace the placeholders before starting the API.
DATABASE_URL=sqlite:///./devantara.db
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:8765","http://127.0.0.1:8765","http://localhost:5500","http://127.0.0.1:5500"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
BOOKING_HOLD_MINUTES=15
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEST_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
RESORT_NAME=Devantara Resort
RESORT_PHONE=
RESORT_ADDRESS=
ADMIN_CONTACT_EMAIL=
